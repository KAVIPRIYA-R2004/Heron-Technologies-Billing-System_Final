# Copy this file to .env and adjust values, then `pip install python-dotenv`
# and load it at the top of app.py (from dotenv import load_dotenv; load_dotenv())
# -- or export these as real environment variables before running the app.

SECRET_KEY=change-this-to-a-long-random-string

# Set USE_SQLITE=1 for a zero-config local database (great for quick testing).
# Leave unset / 0 to use MySQL with the settings below.
USE_SQLITE=0

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=heron_billing

# Default admin login created by `python seed.py`
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Heron@2026
